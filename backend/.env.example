# Copia este archivo como .env y pega los datos de tu proyecto Neon
# (Neon > Connect > Java/JDBC). No subas el .env a git.
DB_URL=jdbc:postgresql://ep-xxxx-xxxx.us-east-2.aws.neon.tech/neondb?sslmode=require
DB_USER=neondb_owner
DB_PASSWORD=tu_password

# true = busca en Open Food Facts los productos que no esten en la base
OFF_ENABLED=true
